{
  "contract": "multizone_dwelling_v1",
  "registry_version": "1.0.0",
  "relative_humidity_convention": "fraction",
  "floating_point": {
    "public_float": "IEEE-754 binary64",
    "public_integer": "signed 64-bit where numerically stored",
    "rounding": "No rounding before aggregation or invariant checks; serialize enough digits for binary64 round trip.",
    "nan_policy": "NaN and infinity are invalid; optional missing values use JSON null.",
    "comparison": "IDs, categories, commands, events, indices, schema, and row order are exact. Numeric rtol/atol are versioned per field group with parity evidence."
  },
  "conversion_policy": {
    "inbound": "Legacy aliases and non-canonical units are converted once in inbound adapters before engine encoding.",
    "kernel": "No presentation or compatibility conversion in physics, behavior, or aggregation kernels.",
    "outbound": "Backend-native state is converted once to canonical units in outbound adapters.",
    "relative_humidity_percent": "Divide legacy percent values by 100 in the adapter; canonical fields use relative_humidity_fraction."
  },
  "energy_convention": {
    "formula": "interval_energy_wh = average_power_w * dt_minutes / 60",
    "interval": "An energy_wh field is interval energy unless prefixed cumulative_.",
    "hierarchy": "Zone interval energy sums to dwelling; dwelling sums to building; scenario energy sums timesteps.",
    "sign": "Consumption and delivered heating/cooling are non-negative magnitudes. Signed balances use explicit heat_gain_w and heat_loss_w fields."
  },
